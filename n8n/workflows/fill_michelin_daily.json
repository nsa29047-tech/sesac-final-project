    },
    {
      "id": "d073113a-9974-58a4-af5a-141cea1664de",
      "name": "연결 실패 정리",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        340
      ],
      "parameters": {
        "jsCode": "// API 호출 노드가 연결하지 못했을 때(오류 출력) 메시지를 만든다. 이 노드 뒤에 메일 노드가 있다.\nconst j = $input.first().json;\nconst msg = (j.error && (j.error.message || j.error.description)) || JSON.stringify(j).slice(0, 300);\nreturn [{ json: { subject: `[파이프라인] ❌ API 연결 실패 (${$workflow.name})`,\n  message: `워크플로우 '${$workflow.name}' 가 파이프라인 API 를 호출하지 못했습니다.\\n오류: ${msg}\\n\\n호스트에서 \\`uv run python src/api/pipeline_server.py\\` 가 켜져 있는지 확인하세요. (n8n 컨테이너는 host.docker.internal:8765 로 호출합니다)` } }];"
      }
    },
