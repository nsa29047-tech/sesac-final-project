    {
      "id": "a81490a1-9362-5d63-8b22-978f3eaa7416",
      "name": "결과 정리",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1560,
        100
      ],
      "parameters": {
        "jsCode": "// 미슐랭 채우기 작업 결과를 정리한다. 이 노드 뒤에 알림 노드를 연결해 쓴다.\nconst j = $input.first().json;\nconst r = j.result || {};\nconst resolved = r.resolved || [], pending = r.still_pending || [];\nif (resolved.length === 0 && pending.length === 0 && !j.exit_code) return [];   // 바뀐 게 없으면 메일을 보내지 않는다\nreturn [{ json: { resolved, still_pending: pending,\n  subject: `[파이프라인] 미슐랭 채우기: 반영 ${resolved.length}개`,\n  message: `미슐랭 채우기 끝: 반영 ${resolved.length}개` + (pending.length ? `, 아직 대기 ${pending.length}개 (하루 한도, 내일 이어서)` : '') +\n           (j.exit_code ? `\\n⚠️ exit ${j.exit_code}` : '') } }];"
      }
    },
    {
      "id": "b08924a6-adfb-5bcd-9d56-8b63a2a19d63",
      "name": "결과 메일",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
