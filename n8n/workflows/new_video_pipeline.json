    {
      "id": "a81490a1-9362-5d63-8b22-978f3eaa7416",
      "name": "결과 정리",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1820,
        100
      ],
      "parameters": {
        "jsCode": "// 방금 끝난 작업의 결과를 영상별 메시지로 정리한다. 이 노드 뒤에 알림 노드(Slack·Discord·이메일)를 연결해 쓴다.\nconst j = $input.first().json;\nconst results = (j.result && j.result.results) || [];\nif (results.length === 0) {\n  return [{ json: { status: 'error', subject: '[파이프라인] ❌ 작업 결과를 읽지 못함',\n    message: `작업 결과를 읽지 못했습니다 (exit ${j.exit_code}): ${(j.output_tail || []).join(' / ')}` } }];\n}\nconst icon = { loaded: '✅', skipped: '⏭️', needs_review: '👀', failed: '❌', pending: '⏸️' };\nreturn results.map(v => ({ json: { ...v,\n  subject: `[파이프라인] ${icon[v.status] || ''} ${v.status} - ${v.title || v.video_id}`,\n  message: `${icon[v.status] || ''} [${v.status}] ${v.title || v.video_id}\\n단계: ${v.stage || '-'} / 자막: ${v.caption_type || '-'}` +\n           (v.skip_reason ? `\\n사유: ${v.skip_reason}` : '') + (v.error ? `\\n오류: ${v.error}` : '') + (v.note ? `\\n참고: ${v.note}` : '') +\n           (v.michelin_pending ? '\\n미슐랭: Parse 한도로 아직 못 채움 (매일 미슐랭 워크플로우가 채움)' : '') } }));"
      }
    },
    {
      "id": "1397dfd9-3db3-5d85-82a2-6c8a79276674",
      "name": "현재 상태",
