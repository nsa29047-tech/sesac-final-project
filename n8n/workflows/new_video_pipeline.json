    {
      "id": "bb416413-e951-588a-bdaa-916d89fd17ca",
      "name": "요약",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1300,
        240
      ],
      "parameters": {
        "jsCode": "// 처리할 영상이 더 없을 때 한 번: 사람이 볼 것들을 요약한다. 이 노드 뒤에 알림 노드를 연결해 쓴다.\nconst s = $input.first().json;\nconst att = s.attention || [];\nconst lines = att.map(v => `- ${v.status}${v.michelin_pending ? '+미슐랭대기' : ''} ${v.video_id} ${v.title || ''} ${v.skip_reason || v.error || ''}`);\nif (att.length === 0) return [];   // 확인할 게 없으면 메일을 보내지 않는다(6시간마다 돌아도 조용하게)\nreturn [{ json: { counts: s.counts, attention: att,\n  subject: `[파이프라인] 확인 필요 ${att.length}건`,\n  message: `파이프라인 한 바퀴 끝. 상태: ${JSON.stringify(s.counts)}` + (lines.length ? `\\n확인 필요:\\n${lines.join('\\n')}` : '') } }];"
      }
    },
