# Docker 스택(compose.yaml)이 읽는 값. 이 파일을 docker/stack.env 로 복사해서 채운다(stack.env 는 git 제외, 커밋 금지).
#   cp docker/stack.env.example docker/stack.env
#   docker compose --env-file docker/stack.env up -d --build
#
# DB 비밀번호 3개는 이 스택 안에서만 쓰는 새 값이다(Supabase 와 무관). 영문·숫자·_- 로 된 12자 이상, 무작위로 만든다.
#   예: openssl rand -hex 16
POSTGRES_PASSWORD=
READONLY_DB_PASSWORD=
APP_DB_PASSWORD=

# Spring 서버의 JWT 서명 키: 32바이트 이상 무작위 문자열(예: openssl rand -hex 32)
JWT_SECRET=

# 챗봇이 쓰는 외부 API 키(기존 .env 와 같은 값)
OPENAI_API_KEY=
GOOGLE_PLACES_API_KEY=

# 선택: 브라우저가 Spring 서버에 접속하는 주소(web 이미지를 빌드할 때 코드에 들어간다. 바꾸면 --build 로 다시 빌드)
# PUBLIC_API_URL=http://localhost:8081
# 선택: Spring 서버가 허용할 프런트 주소
# CORS_ALLOWED_ORIGINS=http://localhost:3000
